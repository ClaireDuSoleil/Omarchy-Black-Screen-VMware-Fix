 		if (ret)
-			return ret;
+			goto out;
 		if (vbo && vbo->is_dumb) {
 			ret = drm_gem_prime_handle_to_fd(dev, file_priv, handle,
 							 flags, prime_fd);
@@ -120,5 +307,9 @@ int vmw_prime_handle_to_fd(struct drm_device *dev,
 		vmw_user_bo_unref(&vbo);
 	}
 
+out:
+	if (bridge_obj)
